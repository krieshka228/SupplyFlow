@page "/products"
@inject IProductService ProductService

<section class="page">
    <header>
        <h1>Товары</h1>
        <button class="primary" @onclick="(() => ShowCreate = !ShowCreate)">Добавить товар</button>
    </header>

    @if (ShowCreate)
    {
        <form class="form" @onsubmit="CreateProduct">
            <label>SKU<input @bind="Form.Sku" required placeholder="SKU-1004" /></label>
            <label>Название<input @bind="Form.Name" required /></label>
            <label>Категория<input @bind="Form.Category" placeholder="Электроника" /></label>
            <label>Цена<input type="number" step="0.01" min="0.01" @bind="Form.Price" required /></label>
            <label>Начальный остаток<input type="number" min="0" @bind="Form.StockQuantity" /></label>
            <label class="wide">Описание<input @bind="Form.Description" /></label>
            <button type="submit">Сохранить</button>
        </form>
    }

    @if (ErrorMessage is not null)
    {
        <div class="error">@ErrorMessage</div>
    }

    <table>
        <thead>
            <tr><th>SKU</th><th>Название</th><th>Категория</th><th>Цена</th><th>Остаток</th><th>Статус</th></tr>
        </thead>
        <tbody>
            @foreach (var product in ProductList)
            {
                <tr>
                    <td>@product.Sku</td>
                    <td>@product.Name</td>
                    <td>@product.Category</td>
                    <td>@product.Price.ToString("N2")</td>
                    <td class="@(product.StockQuantity <= 10 ? "low" : "")">@product.StockQuantity</td>
                    <td>@(product.IsArchived ? "Архив" : "Активен")</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    private IReadOnlyList<ProductDto> ProductList = [];
    private bool ShowCreate;
    private string? ErrorMessage;
    private CreateProductRequest Form = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        ProductList = await ProductService.GetAllAsync();
    }

    private async Task CreateProduct()
    {
        try
        {
            await ProductService.CreateAsync(Form);
            ShowCreate = false;
            ErrorMessage = null;
            Form = new();
            await LoadAsync();
        }
        catch (BusinessRuleException exception)
        {
            ErrorMessage = exception.Message;
        }
    }
}
