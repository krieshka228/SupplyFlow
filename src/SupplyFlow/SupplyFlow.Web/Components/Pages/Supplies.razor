@page "/supplies"
@inject ISupplyService SupplyService
@inject IProductService ProductService
@inject ISupplierService SupplierService
@inject ISupplyWorkflowService WorkflowService

<section class="page">
    <header>
        <h1>Поставки</h1>
        <div class="actions">
            <button class="ghost" @onclick="ResetDemo">Демо-данные</button>
            <button class="primary" @onclick="(() => ShowCreate = !ShowCreate)">Создать поставку</button>
        </div>
    </header>

    @if (ErrorMessage is not null)
    {
        <div class="error">@ErrorMessage</div>
    }

    @if (ShowCreate)
    {
        <form class="form" @onsubmit="CreateSupply">
            <label>
                Поставщик
                <select @bind="SelectedSupplierId">
                    @foreach (var supplier in SupplierList)
                    {
                        <option value="@supplier.Id">@supplier.Name</option>
                    }
                </select>
            </label>
            <label>Склад<input @bind="WarehouseCode" placeholder="WH-MOSCOW" /></label>
            <label class="wide">Комментарий<input @bind="Notes" /></label>

            <table>
                <thead><tr><th>Товар</th><th>Количество</th><th>Цена за единицу</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in NewItems)
                    {
                        <tr>
                            <td>@ProductList.FirstOrDefault(product => product.Id == item.ProductId)?.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N2")</td>
                            <td><button type="button" class="danger small" @onclick="(() => RemoveItem(item))">Удалить</button></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="inline">
                <select @bind="SelectedProductId">
                    @foreach (var product in ProductList)
                    {
                        <option value="@product.Id">@product.Name</option>
                    }
                </select>
                <input type="number" min="1" @bind="Quantity" />
                <input type="number" min="0.01" step="0.01" @bind="UnitPrice" />
                <button type="button" @onclick="AddItem">Добавить позицию</button>
            </div>

            <button type="submit">Создать поставку</button>
        </form>
    }

    @if (SupplyList.Count == 0)
    {
        <div class="empty">Поставок нет. Загрузите демо-данные или создайте новую поставку.</div>
    }
    else
    {
        <table>
            <thead><tr><th>Номер</th><th>Поставщик</th><th>Статус</th><th>Сумма</th><th>Действия</th></tr></thead>
            <tbody>
                @foreach (var supply in SupplyList)
                {
                    <tr>
                        <td>@supply.Number</td>
                        <td>@supply.SupplierName</td>
                        <td><span class="badge @supply.Status.ToString().ToLowerInvariant()">@StatusText[supply.Status]</span></td>
                        <td>@supply.TotalAmount.ToString("N2")</td>
                        <td>
                            @if (supply.Status == SupplyStatus.Draft)
                            {
                                <button class="small" @onclick="() => SubmitSupply(supply.Id)">Отправить</button>
                                <button class="danger small" @onclick="() => CancelSupply(supply.Id)">Отменить</button>
                            }
                            else if (supply.Status == SupplyStatus.Submitted)
                            {
                                <button class="small" @onclick="() => SendSupplyToTransit(supply.Id)">В путь</button>
                                <button class="danger small" @onclick="() => CancelSupply(supply.Id)">Отменить</button>
                            }
                            else if (supply.Status == SupplyStatus.InTransit)
                            {
                                <button class="small" @onclick="() => MarkSupplyDelivered(supply.Id)">Доставлена</button>
                                <button class="danger small" @onclick="() => RejectSupply(supply.Id)">Отклонить</button>
                            }
                            else if (supply.Status == SupplyStatus.Delivered)
                            {
                                <button class="success small" @onclick="() => AcceptSupply(supply.Id)">Принять</button>
                                <button class="danger small" @onclick="() => RejectSupply(supply.Id)">Отклонить</button>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private IReadOnlyList<SupplyDto> SupplyList = [];
    private IReadOnlyList<ProductDto> ProductList = [];
    private IReadOnlyList<SupplierDto> SupplierList = [];
    private readonly Dictionary<SupplyStatus, string> StatusText = new()
    {
        [SupplyStatus.Draft] = "Черновик",
        [SupplyStatus.Submitted] = "Отправлена",
        [SupplyStatus.InTransit] = "В пути",
        [SupplyStatus.Delivered] = "Доставлена",
        [SupplyStatus.Accepted] = "Принята",
        [SupplyStatus.Rejected] = "Отклонена",
        [SupplyStatus.Cancelled] = "Отменена"
    };

    private bool ShowCreate;
    private string? ErrorMessage;
    private Guid SelectedSupplierId;
    private Guid SelectedProductId;
    private string WarehouseCode = "WH-MOSCOW";
    private string Notes = "";
    private int Quantity = 1;
    private decimal UnitPrice = 1;
    private readonly List<CreateSupplyItemRequest> NewItems = [];

    protected override async Task OnInitializedAsync()
    {
        ProductList = await ProductService.GetAllAsync();
        SupplierList = await SupplierService.GetAllAsync();
        SupplyList = await SupplyService.GetAllAsync();
        SelectedSupplierId = SupplierList.FirstOrDefault()?.Id ?? Guid.Empty;
        SelectedProductId = ProductList.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private async Task LoadAsync()
    {
        SupplyList = await SupplyService.GetAllAsync();
        ProductList = await ProductService.GetAllAsync();
        SupplierList = await SupplierService.GetAllAsync();
    }

    private void AddItem()
    {
        NewItems.Add(new CreateSupplyItemRequest(SelectedProductId, Quantity, UnitPrice));
        Quantity = 1;
        UnitPrice = 1;
    }

    private void RemoveItem(CreateSupplyItemRequest item) => NewItems.Remove(item);

    private async Task CreateSupply()
    {
        try
        {
            var request = new CreateSupplyRequest(SelectedSupplierId, WarehouseCode, Notes, NewItems.ToList());
            await SupplyService.CreateAsync(request);
            NewItems.Clear();
            ShowCreate = false;
            ErrorMessage = null;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
    }

    private async Task SubmitSupply(Guid id) => await ExecuteTransition(() => SupplyService.SubmitAsync(id));
    private async Task SendSupplyToTransit(Guid id) => await ExecuteTransition(() => SupplyService.SendToTransitAsync(id));
    private async Task MarkSupplyDelivered(Guid id) => await ExecuteTransition(() => SupplyService.MarkDeliveredAsync(id));
    private async Task AcceptSupply(Guid id) => await ExecuteTransition(() => SupplyService.AcceptAsync(id));
    private async Task RejectSupply(Guid id) => await ExecuteTransition(() => SupplyService.RejectAsync(id, "Отклонено вручную"));
    private async Task CancelSupply(Guid id) => await ExecuteTransition(() => SupplyService.CancelAsync(id));

    private async Task ExecuteTransition(Func<Task> action)
    {
        try
        {
            await action();
            ErrorMessage = null;
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        await LoadAsync();
    }

    private async Task ResetDemo()
    {
        await WorkflowService.ResetDemoDataAsync();
        NewItems.Clear();
        ShowCreate = false;
        ErrorMessage = null;
        await LoadAsync();
        SelectedSupplierId = SupplierList.FirstOrDefault()?.Id ?? Guid.Empty;
        SelectedProductId = ProductList.FirstOrDefault()?.Id ?? Guid.Empty;
    }
}
